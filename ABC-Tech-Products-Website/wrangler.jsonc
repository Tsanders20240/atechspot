{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "abc-tech-products",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",
  "routes": [
    {"pattern":"abctechproducts.atechspot.com","custom_domain":true},
    {"pattern":"www.abctechproducts.atechspot.com","custom_domain":true}
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
