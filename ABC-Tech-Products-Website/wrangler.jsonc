{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "abc-tech-products",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "routes": [
    {"pattern":"abctechproducts.atechspot.com/*","zone_name":"atechspot.com"},
    {"pattern":"www.abctechproducts.atechspot.com/*","zone_name":"atechspot.com"}
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
