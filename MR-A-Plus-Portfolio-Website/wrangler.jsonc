{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mraplusportfolio-site",
  "compatibility_date": "2026-09-24",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {"pattern":"www.mraplusportfolio.atechspot.com","custom_domain":true},
    {"pattern":"mraplusportfolio.atechspot.com","custom_domain":true}
  ]
}
