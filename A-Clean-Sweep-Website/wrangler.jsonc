{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "a-clean-sweep",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "routes": [{"pattern":"acleansweep.atechspot.com/*","zone_name":"atechspot.com"}],
  "assets": {"directory":"./public","binding":"ASSETS","not_found_handling":"404-page","run_worker_first":true}
}
