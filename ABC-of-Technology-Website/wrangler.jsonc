{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "abc-of-technology",
  "main": "seo-worker.js",
  "compatibility_date": "2026-09-22",
  "routes": [
    {
      "pattern": "abcoftech.atechspot.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
